[Unit]
Description=Starwave Pi-Star live recording and transcription
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@START_SCRIPT@
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=65536
TasksMax=256
MemoryHigh=3G
MemoryMax=4G
OOMPolicy=stop

[Install]
WantedBy=default.target
