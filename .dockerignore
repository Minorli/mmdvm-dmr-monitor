# Only application/build inputs enter the context. New directories stay private
# until they are explicitly included here.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!LICENSE
!backend/
!backend/**
!native/
!native/dmrdecode.c
!native/dmrdecode.h
