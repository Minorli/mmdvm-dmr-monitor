# Web starts in standby; use the panel's Start/Stop controls.
PI_STAR_HOST=pi-star@pi-star.local
DEVICE_NAME=Pi-Star
BIND_HOST=127.0.0.1
PORT=8788
SSH_PORT=22

# Host setup: a dedicated SSH identity and verified known-hosts file.
# Docker: use deploy/compose.ssh.yaml and file-based secrets.
# SSH_KEY_FILE=/path/to/pi_identity
# SSH_KNOWN_HOSTS_FILE=/path/to/pi_known_hosts
# SSH_PASSWORD_FILE=/path/to/private-password-file
# Or use the Web connection panel to configure the address, user and password.

OPENAI_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_API=responses
TRANSLATION_ENABLED=true
# Set only ONE of OPENAI_API_KEY and OPENAI_API_KEY_FILE.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# CONTROL_TOKEN_FILE=/run/secrets/control_token
CONTROL_TOKEN=

DATA_DIR=./data
CACHE_DIR=./.cache/whisper
RECORDING_TIMEZONE=Asia/Shanghai
MIN_CALL_SECONDS=1
MAX_SEGMENT_SECONDS=20
# 0 keeps recordings indefinitely. Only finished, nonpending audio expires.
AUDIO_RETENTION_DAYS=0
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=2
TRANSCRIPTION_WORKERS=2
TRANSLATION_WORKERS=2
RETRY_ATTEMPTS=4
RETRY_BASE_SECONDS=5
JOB_LEASE_SECONDS=300
LIVE_JOB_AGE_SECONDS=300
CAPTURE_TIMEOUT_SECONDS=20
RECONNECT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60
